<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CASIO "
        android:textSize="30sp"
        android:id="@+id/edt"
        android:layout_alignParentEnd="true"

     />

    <EditText
        android:id="@+id/edt1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/edt"
        android:layout_alignParentEnd="true"
        android:hint="0"
        android:minWidth="32dp"
        android:textSize="30sp" />

    <Button
        android:id="@+id/btn1"
        android:layout_width="65sp"
        android:layout_height="65sp"
        android:layout_below="@+id/edt1"
        android:layout_marginStart="10sp"
        android:text="1"
        android:textSize="20sp" />



    <Button
        android:id="@+id/btn2"
        android:layout_width="65sp"
        android:layout_height="65sp"
        android:layout_below="@+id/edt1"
        android:layout_marginLeft="10sp"
        android:layout_toRightOf="@+id/btn1"
        android:text="2"
        android:textSize="20sp" />
    <Button
        android:id="@+id/btn3"
        android:layout_width="65sp"
        android:layout_height="65sp"
        android:layout_below="@+id/edt1"
        android:layout_marginLeft="10sp"
        android:layout_toRightOf="@+id/btn2"
        android:text="3"
        android:textSize="20sp"/>
    <Button
        android:id="@+id/btn4"
        android:layout_width="65sp"
        android:layout_height="65sp"
        android:layout_below="@+id/btn1"
        android:layout_marginLeft="10sp"
        android:text="4"
        android:textSize="20sp"/>
    <Button
        android:id="@+id/btn5"
        android:layout_width="65sp"
        android:layout_height="65sp"
        android:layout_below="@+id/btn2"
        android:layout_marginLeft="10sp"
        android:layout_toRightOf="@+id/btn4"
        android:text="5"
        android:textSize="20sp"/>
    <Button
        android:id="@+id/btn6"
        android:layout_width="65sp"
        android:layout_height="65sp"
        android:layout_below="@+id/btn3"
        android:layout_marginLeft="10sp"
        android:layout_toRightOf="@+id/btn5"
        android:text="6"
        android:textSize="20sp"/>

    <Button
        android:id="@+id/btn7"
        android:layout_width="65sp"
        android:layout_height="65sp"
        android:layout_below="@+id/btn4"
        android:layout_marginLeft="10sp"
        android:layout_marginTop="7sp"
        android:text="7"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btn8"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_below="@+id/btn5"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="11dp"
        android:layout_toRightOf="@+id/btn7"
        android:text="8"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btn9"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_below="@+id/btn6"
        android:layout_marginLeft="10sp"
        android:layout_toRightOf="@+id/btn8"
        android:text="9"
        android:textSize="20sp"/>

    <Button
        android:id="@+id/btn66"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_below="@+id/btn7"
        android:layout_marginLeft="10sp"
        android:layout_marginTop="12sp"
        android:text="."
        android:textSize="20sp" />

    <Button
        android:id="@+id/btn20"
        android:layout_width="65sp"
        android:layout_height="65sp"
        android:layout_below="@+id/btn8"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="9dp"
        android:layout_toRightOf="@+id/btn66"
        android:text="0"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btn21"
        android:layout_width="65sp"
        android:layout_height="65sp"
        android:layout_below="@+id/btn9"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="19sp"
        android:layout_toRightOf="@+id/btn20"
        android:text="c"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btn11"
        android:layout_width="165sp"
        android:layout_height="65sp"
        android:layout_below="@+id/edt1"
        android:layout_marginLeft="10sp"
        android:layout_toRightOf="@+id/btn3"
        android:text="+"
        android:textSize="20sp"/>
    <Button
        android:id="@+id/btn12"
        android:layout_width="165sp"
        android:layout_height="65sp"
        android:layout_below="@+id/btn11"
        android:layout_marginLeft="10sp"
        android:layout_toRightOf="@+id/btn6"
        android:text="-"
        android:textSize="20sp"/>
    <Button
        android:id="@+id/btn13"
        android:layout_width="165sp"
        android:layout_height="65dp"
        android:layout_below="@+id/btn12"
        android:layout_marginLeft="10sp"
        android:layout_toRightOf="@+id/btn9"
        android:text="/"
        android:textSize="20dp"/>

    <Button
        android:id="@+id/btn14"
        android:layout_width="165sp"
        android:layout_height="65sp"
        android:layout_below="@+id/btn13"
        android:layout_marginLeft="8sp"
        android:layout_marginTop="15sp"
        android:layout_toRightOf="@+id/btn3"
        android:text="x"
        android:textSize="20sp" />

    <Button
        android:id="@+id/btn55"
        android:layout_width="390sp"
        android:layout_height="65sp"
        android:layout_below="@+id/btn14"
        android:layout_marginLeft="10sp"
        android:layout_marginTop="19sp"
        android:text="="
        android:textSize="20sp" />


</RelativeLayout>